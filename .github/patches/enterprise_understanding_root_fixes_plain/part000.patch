+def _managed_conflict_refs(fact: dict[str, Any]) -> list[str]:
+    return [
+        _text(value)
+        for value in _list(fact.get("conflict_refs"))
+        if _text(value).startswith(_MANAGED_CONFLICT_REF_PREFIXES)
+    ]
+
