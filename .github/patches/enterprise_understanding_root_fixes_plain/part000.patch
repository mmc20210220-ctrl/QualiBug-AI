+def _status_without_managed_conflict(fact: dict[str, Any]) -> str:
+    """Recover the source fact status after a no-longer-present conflict.
+
+    Conflict reconciliation is recomputed after semantic normalization. A broad
+    early pass may temporarily group two facts; later exact actors, conditions or
+    interface identities can prove they are different statements. The conflict
+    authority must therefore be a current-state projection, not an append-only
+    mutation of the fact ledger.
+    """
+    lifecycle = _dict(fact.get("conflict_lifecycle"))
+    previous = _text(lifecycle.get("previous_status"))
+    if previous in {"ACCEPTED", "PENDING"}:
+        return previous
+    quality = _dict(fact.get("resolution_quality"))
+    evidence = _dict(fact.get("evidence_closure"))
+    complete = (
+        not _list(fact.get("ambiguities"))
+        and _text(evidence.get("status")) == "PASS"
+        and quality.get("actor_resolved") is not False
+        and quality.get("entity_resolved") is not False
+        and quality.get("condition_logic_resolved") is not False
+    )
+    return "ACCEPTED" if complete else "PENDING"
+
+
+def _clear_stale_managed_conflict(fact: dict[str, Any]) -> bool:
+    refs = _managed_conflict_refs(fact)
+    all_refs = [_text(value) for value in _list(fact.get("conflict_refs")) if _text(value)]
+    if _text(fact.get("status")) != "CONFLICTING" or not refs:
+        return False
+    # Another conflict authority may still own this fact. Only clear when every
+    # attached reference belongs to this recomputed authority.
+    if set(refs) != set(all_refs):
+        return False
+    restored = _status_without_managed_conflict(fact)
+    fact["status"] = restored
+    fact.pop("conflict_refs", None)
+    fact.pop("formal_promotion_allowed", None)
+    if _text(fact.get("authority_resolution")) == "UNRESOLVED":
+        fact.pop("authority_resolution", None)
+    quality = _dict(fact.get("resolution_quality"))
+    if quality:
+        quality["status"] = restored
+        fact["resolution_quality"] = quality
+    lifecycle = _dict(fact.get("conflict_lifecycle"))
+    lifecycle.update(
+        {
+            "status": "CLEARED_AFTER_RECOMPUTE",
+            "previous_status": restored,
+            "stale_conflict_refs_removed": sorted(refs),
+            "automatic_authority_winner_selected": False,
+        }
+    )
+    fact["conflict_lifecycle"] = lifecycle
+    return True
