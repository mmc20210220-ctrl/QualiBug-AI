     assert gate["entry_allowed"] is False
 
 
+def test_stale_conflict_clears_after_current_semantics_prove_different_actors() -> None:
+    left = _fact(
+        "fact:customer-close",
+        "只有客户可以关闭工单",
+        status="CONFLICTING",
+        modality="MAY",
+    )
+    right = _fact(
+        "fact:admin-close",
+        "只有管理员不允许关闭工单",
+        status="CONFLICTING",
+        modality="MUST_NOT",
+        polarity="NEGATIVE",
+    )
+    for fact in (left, right):
+        fact["subject"]["actor_refs"] = []
+        fact["conflict_refs"] = [
+            "conflict:business_modality_contradiction:temporary"
+        ]
+        fact["conflict_lifecycle"] = {
+            "status": "ACTIVE",
+            "previous_status": "ACCEPTED",
+        }
+    asset = {
+        "business_objects": [{"name": "工单"}],
+        "roles": [
+            {
+                "role": "CUSTOMER",
+                "canonical_name": "CUSTOMER",
+                "aliases": ["客户"],
+                "identity_authority": "SOURCE_DECLARED_ROLE_TABLE",
+            },
+            {
+                "role": "ADMIN",
+                "canonical_name": "ADMIN",
+                "aliases": ["管理员"],
+                "identity_authority": "SOURCE_DECLARED_ROLE_TABLE",
+            },
+        ],
+        "business_fact_ledger": {"items": [left, right]},
+        "business_rules": [
+            {"rule_id": "rule:customer", "fact_id": left["fact_id"]},
+            {"rule_id": "rule:admin", "fact_id": right["fact_id"]},
+        ],
+        "enterprise_comprehension_gate": {
+            "status": "BLOCKED_BUSINESS_COMPREHENSION_CONFLICTING_FACTS",
+            "entry_allowed": False,
+            "required_operator_action": "resolve_conflicts",
+        },
+        "unknown_semantics": [],
+    }
+
+    normalized = normalize_explicit_business_fact_semantics(asset)
+    normalized_facts = normalized["business_fact_ledger"]["items"]
+    assert normalized_facts[0]["subject"]["actor_refs"] == ["CUSTOMER"]
+    assert normalized_facts[1]["subject"]["actor_refs"] == ["ADMIN"]
+    assert _semantic_signature(normalized_facts[0]) != _semantic_signature(normalized_facts[1])
+
+    result = reconcile_chinese_business_fact_conflicts(normalized)
+
+    assert result["chinese_business_comprehension_conflicts"] == []
+    facts = result["business_fact_ledger"]["items"]
+    assert {row["status"] for row in facts} == {"ACCEPTED"}
+    assert all("conflict_refs" not in row for row in facts)
+    assert all(
+        row["conflict_lifecycle"]["status"] == "CLEARED_AFTER_RECOMPUTE"
+        for row in facts
+    )
+    assert result["business_rules"] == [
+        {"rule_id": "rule:customer", "fact_id": left["fact_id"]},
+        {"rule_id": "rule:admin", "fact_id": right["fact_id"]},
+    ]
+    assert result["enterprise_comprehension_gate"]["status"] == "PASS"
+    assert result["enterprise_comprehension_gate"]["entry_allowed"] is True
+
+
