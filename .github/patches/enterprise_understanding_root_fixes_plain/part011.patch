+    root = tmp_path / "repo"
+    source = root / "projects" / "demo" / "input" / "rules.md"
+    source.parent.mkdir(parents=True, exist_ok=True)
+    source.write_bytes(b"rule one\r\nrule two\r\n")
+    expected = _git_blob_sha(b"rule one\nrule two\n")
+    manifest = root / "source_manifest.json"
+    _write_json(
+        manifest,
+        {
+            "schema": SOURCE_MANIFEST_SCHEMA,
+            "project_id": "demo",
+            "product_phase_may_load_ground_truth": False,
+            "sources": [
+                {
+                    "path": "projects/demo/input/rules.md",
+                    "source_ref": "source://demo/rules",
+                    "source_type": "business_rules",
+                    "blob_sha": expected,
+                }
+            ],
+            "excluded_from_product_phase": [],
+        },
+    )
+
+    captured: dict[str, object] = {}
+
+    def ingest(project_id, documents, *, root, actor):
+        captured["documents"] = documents
+        return _ingest_receipt(project_id, documents)
+
+    def build(project_id, workspace, options):
+        return _product_asset(project_id, ["source://demo/rules"])
+
+    def capture(**kwargs):
+        _write_json(Path(kwargs["output_path"]), _product_asset("demo", ["source://demo/rules"]))
+        return {"status": "CAPTURED"}
+
+    receipt = build_isolated_product_snapshot(
+        project_id="demo",
+        product_root=root,
+        workspace_root=tmp_path / "workspace",
+        manifest_path=manifest,
+        asset_output_path=tmp_path / "asset" / "final_asset.json",
+        receipt_output_path=tmp_path / "receipt" / "receipt.json",
+        authorities=(ingest, build),
+    )
+
+    source_receipt = receipt["source_receipts"][0]
+    assert source_receipt["blob_sha"] == expected
+    assert source_receipt["canonical_blob_sha"] == expected
+    assert source_receipt["raw_blob_sha"] != expected
+    assert source_receipt["line_ending_normalized_for_identity"] is True
+    assert source_receipt["source_content_identity_mode"] == "CANONICAL_UTF8_TEXT_GIT_BLOB"
