@@ -0,0 +1,103 @@
+from __future__ import annotations
+
+from ai_test_asset_center.enterprise_knowledge_center.enterprise_understanding.behavior_ir import (
+    _behaviors_from_fact,
+)
+from ai_test_asset_center.enterprise_knowledge_center.enterprise_understanding.builder_legacy_v1 import (
+    _build_operations,
+)
+from ai_test_asset_center.enterprise_knowledge_center.enterprise_understanding.implementation_binding import (
+    exact_interface_operation_identities,
+)
+
+
+def _interface(interface_id: str, operation_id: str, summary: str) -> dict:
+    method, path = interface_id.removeprefix("api:").split(":", 1)
+    return {
+        "interface_id": interface_id,
+        "operation_id": operation_id,
+        "summary": summary,
+        "method": method,
+        "path": path,
+        "source_id": "openapi",
+    }
+
+
+def _asset() -> dict:
+    return {
+        "interfaces": [
+            _interface("api:GET:/tickets", "listTickets", "获取工单列表"),
+            _interface("api:GET:/tickets/{ticketId}", "getTicket", "获取工单详情"),
+        ]
+    }
+
+
+def _fact(interface_refs: list[str]) -> dict:
+    return {
+        "fact_id": "fact:tenant-filter",
+        "kind": "RULE",
+        "fact_type": "PERMISSION_RULE",
+        "status": "ACCEPTED",
+        "action": {"canonical": "查看", "raw": "查看"},
+        "subject": {"actor_refs": ["客户"], "entity_refs": ["Ticket"]},
+        "object": {"entity_refs": ["Ticket"]},
+        "interface_refs": interface_refs,
+        "conditions": ["本租户"],
+        "condition_combinator": "SINGLE_CONDITION",
+        "modality": "ONLY_IF",
+        "polarity": "POSITIVE",
+        "source_spans": [
+            {
+                "source_id": "openapi",
+                "locator": "openapi.yaml#operation",
+                "quote": "客户只能查看本租户的工单",
+            }
+        ],
+        "raw_statement": "客户只能查看本租户的工单",
+    }
+
+
+def test_exact_interface_operation_identity_uses_only_source_declared_operation_id() -> None:
+    identities = exact_interface_operation_identities(
+        _asset(),
+        ["api:GET:/tickets", "api:GET:/missing"],
+    )
+
+    assert [row["operation_ref"] for row in identities] == ["listTickets"]
+    assert identities[0]["operation_aliases"] == ["listTickets", "获取工单列表"]
+    assert identities[0]["authority"] == "OPENAPI_OPERATION_ID"
+
+
+def test_operation_model_projects_one_semantic_rule_into_each_exact_interface_operation() -> None:
+    operations, unknowns = _build_operations(
+        [_fact(["api:GET:/tickets", "api:GET:/tickets/{ticketId}"])],
+        asset=_asset(),
+    )
+
+    assert unknowns == []
+    assert {row["operation_ref"] for row in operations} == {"listTickets", "getTicket"}
+    assert all(row["name"] != "查看" for row in operations)
+    by_ref = {row["operation_ref"]: row for row in operations}
+    assert by_ref["listTickets"]["interface_refs"] == ["api:GET:/tickets"]
+    assert by_ref["getTicket"]["interface_refs"] == ["api:GET:/tickets/{ticketId}"]
+    assert "获取工单列表" in by_ref["listTickets"]["raw_action_names"]
+    assert "Ticket" in by_ref["listTickets"]["object_refs"]
+
+
+def test_behavior_ir_fans_out_exact_operations_without_endpoint_guessing() -> None:
+    behaviors = _behaviors_from_fact(
+        _asset(),
+        _fact(["api:GET:/tickets", "api:GET:/tickets/{ticketId}"]),
+    )
+
+    assert {row["operation_ref"] for row in behaviors} == {"listTickets", "getTicket"}
+    assert len({row["behavior_id"] for row in behaviors}) == 2
+    assert {tuple(row["interface_refs"]) for row in behaviors} == {
+        ("api:GET:/tickets",),
+        ("api:GET:/tickets/{ticketId}",),
+    }
+    assert all(row["operation_identity_authority"] == "OPENAPI_OPERATION_ID" for row in behaviors)
+    assert all(row["status"] == "CONFIRMED" for row in behaviors)
diff --git a/tests/test_source_declared_role_identity.py b/tests/test_source_declared_role_identity.py
new file mode 100644
index 0000000..3616d98
--- /dev/null
+++ b/tests/test_source_declared_role_identity.py
@@ -0,0 +1,126 @@
+from __future__ import annotations
+
+from ai_test_asset_center.enterprise_knowledge_center._parsing import _roles_from_text
+from ai_test_asset_center.enterprise_knowledge_center.enterprise_understanding.behavior_ir import (
+    _behavior_from_fact,
+)
+from ai_test_asset_center.enterprise_knowledge_center.enterprise_understanding.builder_legacy_v1 import (
+    _build_actors,
+)
+from ai_test_asset_center.enterprise_knowledge_center.enterprise_understanding.explicit_fact_semantic_normalization import (
+    normalize_explicit_business_fact_semantics,
+)
+
+
+ROLE_TABLE = """
+| 角色 | 权限说明 |
+|------|----------|
+| CUSTOMER | 客户，可创建工单、查看自己的工单 |
+| AGENT | 客服代理，可处理分配的工单 |
+| SUPERVISOR | 主管，可分配和升级工单 |
+| ADMIN | 管理员，拥有全部权限 |
+"""
+
+
+def _fact(statement: str, actor: str) -> dict:
+    return {
+        "fact_id": "fact:role",
+        "kind": "RULE",
+        "status": "ACCEPTED",
+        "raw_statement": statement,
+        "subject": {"actor_refs": [actor], "entity_refs": ["工单"]},
+        "object": {"entity_refs": ["工单"]},
+        "action": {"canonical": "操作", "raw": "操作"},
+        "conditions": [],
+        "condition_combinator": "",
+        "condition_frame": {},
+        "state_effects": [],
+        "data_effects": [],
+        "postconditions": [],
+        "source_spans": [
+            {"source_id": "source:rules", "locator": "line:1", "quote": statement}
+        ],
+    }
+
+
+def test_source_declared_role_table_outranks_lexicon_role_translation() -> None:
+    roles = _roles_from_text(ROLE_TABLE + "\ncustomer tenant 客服", "source:rules")
+
+    assert [row["role"] for row in roles] == [
+        "CUSTOMER",
+        "AGENT",
+        "SUPERVISOR",
+        "ADMIN",
+    ]
+    assert roles[0]["aliases"] == ["客户"]
+    assert roles[1]["aliases"] == ["客服代理", "代理"]
+    assert roles[2]["aliases"] == ["主管"]
+    assert roles[3]["aliases"] == ["管理员"]
+    assert all(row["identity_authority"] == "SOURCE_DECLARED_ROLE_TABLE" for row in roles)
+    assert not {"buyer", "operator", "support", "tenant_user"} & {
+        row["role"] for row in roles
+    }
+
+
+def test_source_preserving_blank_lines_do_not_destroy_role_table_identity() -> None:
+    projected = "\n\n".join(line for line in ROLE_TABLE.strip().splitlines())
+
+    roles = _roles_from_text(projected, "source:projected")
+
+    assert [row["role"] for row in roles] == [
+        "CUSTOMER",
+        "AGENT",
+        "SUPERVISOR",
+        "ADMIN",
+    ]
+    assert roles[1]["aliases"] == ["客服代理", "代理"]
+
+
+def test_fact_actor_coordinate_uses_source_declared_canonical_role() -> None:
+    roles = _roles_from_text(ROLE_TABLE, "source:rules")
+    asset = {
+        "roles": roles,
+        "business_fact_ledger": {
+            "items": [_fact("只有被分配的代理可以操作", "代理")]
+        },
+    }
+
+    normalized = normalize_explicit_business_fact_semantics(asset)
+    fact = normalized["business_fact_ledger"]["items"][0]
+    behavior = _behavior_from_fact(fact)
+
+    assert fact["subject"]["actor_refs"] == ["AGENT"]
+    assert "被分配" in fact["conditions"]
+    assert behavior is not None
+    assert behavior["actor_refs"] == ["AGENT"]
+
+
+def test_actor_model_uses_role_table_as_single_identity_authority() -> None:
+    explicit = _roles_from_text(ROLE_TABLE, "source:rules")
+    asset = {
+        "roles": [
+            *explicit,
+            {
+                "role_id": "role:api:buyer",
+                "source_id": "source:api",
+                "role": "buyer",
+                "aliases": ["customer"],
+                "identity_authority": "LEXICON_FALLBACK",
+            },
+            {
+                "role_id": "role:api:admin",
+                "source_id": "source:api",
+                "role": "admin",
+                "aliases": ["管理员"],
+                "identity_authority": "LEXICON_FALLBACK",
+            },
+        ],
+        "permission_matrix": [
+            {
+                "permission_id": "permission:admin",
+                "role": "admin",
+                "resource": "SLA",
+                "actions": ["create"],
+                "decision": "allow",
+            }
+        ],
+    }
+    facts = [_fact("只有客户可以操作工单", "CUSTOMER")]
+    operations = [
+        {
+            "operation_id": "operation:create-ticket",
+            "actor_refs": ["客户"],
+            "evidence": [],
+        }
+    ]
+
+    actors, _unknowns = _build_actors(asset, facts, operations)
+    by_name = {row["name"]: row for row in actors}
+
+    assert set(by_name) == {"CUSTOMER", "AGENT", "SUPERVISOR", "ADMIN"}
+    assert by_name["CUSTOMER"]["aliases"] == ["客户"]
+    assert set(by_name["AGENT"]["aliases"]) == {"客服代理", "代理"}
+    assert set(by_name["ADMIN"]["aliases"]) == {"管理员", "admin"}
+    assert by_name["CUSTOMER"]["responsibility_operation_refs"] == [
+        "operation:create-ticket"
+    ]
+    assert by_name["ADMIN"]["authorization_decision_counts"]["ALLOW"] == 1
diff --git a/tests/test_term_alias_identity_pipeline.py b/tests/test_term_alias_identity_pipeline.py
new file mode 100644
index 0000000..5b93e8f
--- /dev/null
+++ b/tests/test_term_alias_identity_pipeline.py
@@ -0,0 +1,84 @@
+from __future__ import annotations
+
+from ai_test_asset_center.enterprise_knowledge_center._chinese_business_comprehension_extractor_v1 import (
+    analyze_chinese_business_source,
+)
+from ai_test_asset_center.enterprise_knowledge_center.enterprise_understanding.structured_fact_compiler import (
+    compile_structure_first_business_facts,
+)
+
+
+def _alias(fact_id: str, canonical: str, alias: str) -> dict:
+    statement = f"实体={alias};说明={canonical}"
+    return {
+        "fact_id": fact_id,
+        "kind": "TERM_ALIAS",
+        "status": "ACCEPTED",
+        "canonical_term": canonical,
+        "alias": alias,
+        "raw_statement": statement,
+        "source_spans": [
+            {
+                "source_id": "business-rules",
+                "locator": f"BUSINESS_RULES.md#alias={fact_id}",
+                "quote": statement,
+                "quote_hash": f"hash-{fact_id}",
+            }
+        ],
+        "ambiguities": [],
+    }
+
+
+def test_markdown_table_headers_do_not_leak_into_later_tables() -> None:
+    text = """\
+| 实体 | 说明 |
+| --- | --- |
+| Ticket | 工单，核心业务实体 |
+| Comment | 工单评论 |
+
+## 规则
+
+| 规则ID | 规则类型 | 规则描述 |
+| --- | --- | --- |
+| BR-001 | AUTHORIZATION | 客户只能查看自己的工单 |
+| BR-002 | STATE_TRANSITION | 已关闭工单不能评论 |
+"""
+
+    _, _, glossary = analyze_chinese_business_source(
+        {"source_id": "business-rules", "filename": "BUSINESS_RULES.md", "text": text},
+        asset={"business_objects": [], "roles": [], "permission_matrix": [], "data_tables": []},
+    )
+
+    assert {(row["canonical_term"], row["alias"]) for row in glossary} == {
+        ("工单", "Ticket"),
+        ("工单评论", "Comment"),
+    }
+    assert not any(str(row.get("alias", "")).startswith("BR-") for row in glossary)
+    assert not any(row.get("canonical_term") == "AUTHORIZATION" for row in glossary)
+
+
+def test_structure_first_signature_preserves_every_term_alias_pair() -> None:
+    aliases = [
+        _alias("ticket", "工单", "Ticket"),
+        _alias("comment", "工单评论", "Comment"),
+        _alias("attachment", "工单附件", "Attachment"),
+    ]
+    asset = {
+        "asset_id": "term-alias-pipeline",
+        "business_fact_ledger": {
+            "schema": "qualibug.business-fact-ledger.v1",
+            "fact_authority": "original_chinese_source_span",
+            "items": aliases,
+        },
+    }
+
+    result = compile_structure_first_business_facts(asset, [])
+    rows = [
+        row
+        for row in result["business_fact_ledger"]["items"]
+        if row.get("fact_type") == "TERM_ALIAS"
+    ]
+
+    assert len(rows) == 3
+    assert {(row["canonical_term"], row["alias"]) for row in rows} == {
+        ("工单", "Ticket"),
+        ("工单评论", "Comment"),
+        ("工单附件", "Attachment"),
+    }
+    assert len({row["semantic_signature"] for row in rows}) == 3
