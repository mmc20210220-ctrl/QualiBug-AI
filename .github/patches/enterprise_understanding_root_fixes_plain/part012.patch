@@ -0,0 +1,194 @@
+from __future__ import annotations
+
+from ai_test_asset_center.enterprise_knowledge_center.enterprise_understanding.behavior_ir import (
+    _behavior_from_fact,
+)
+from ai_test_asset_center.enterprise_knowledge_center.enterprise_understanding.explicit_fact_semantic_normalization import (
+    normalize_explicit_business_fact_semantics,
+)
+from ai_test_asset_center.enterprise_knowledge_center.enterprise_understanding.lifecycle_builder import (
+    build_lifecycles,
+    source_declared_state_catalog,
+)
+from ai_test_asset_center.enterprise_knowledge_center.enterprise_understanding.structured_fact_compiler import (
+    _merge_same_signature,
+)
+
+
+def _span(rule: str, statement: str) -> list[dict]:
+    return [{"source_id": "source:rules", "locator": f"rules.md#{rule}", "quote": statement}]
+
+
+def _fact(rule: str, rule_type: str, statement: str, *, interface_id: str = "") -> dict:
+    refs = [interface_id] if interface_id else []
+    return {
+        "fact_id": f"fact:{rule}",
+        "status": "ACCEPTED",
+        "kind": "RULE",
+        "fact_type": "PERMISSION_RULE",
+        "raw_statement": f"| {rule} | {rule_type} | {statement} |",
+        "subject": {"actor_refs": [], "entity_refs": ["订单"]},
+        "object": {"entity_refs": ["订单"]},
+        "action": {},
+        "predicate": "",
+        "conditions": [],
+        "condition_combinator": "",
+        "state_effects": [],
+        "data_effects": [],
+        "postconditions": [],
+        "modality": "MAY",
+        "interface_id": interface_id,
+        "interface_refs": refs,
+        "source_spans": _span(rule, statement),
+    }
+
+
+def _asset(facts: list[dict]) -> dict:
+    return {
+        "business_objects": [{"name": "订单"}],
+        "roles": [
+            {"role": "CUSTOMER", "canonical_role": "CUSTOMER", "aliases": ["客户"]}
+        ],
+        "interfaces": [
+            {
+                "interface_id": "api:POST:/orders/{id}/ship",
+                "operation_id": "shipOrder",
+                "method": "POST",
+                "path": "/orders/{id}/ship",
+                "summary": "发货",
+                "source_id": "source:openapi",
+            }
+        ],
+        "state_machines": [
+            {
+                "state_machine_id": "state:order",
+                "source_id": "source:rules",
+                "object": "order",
+                "states": ["OPEN", "SHIPPED", "CLOSED"],
+                "transitions": [
+                    {"from": "OPEN", "to": "SHIPPED"},
+                    {"from": "SHIPPED", "to": "CLOSED"},
+                ],
+            }
+        ],
+        "term_alias_identity_merge": {
+            "alias_to_canonical": {"Order": "订单"},
+            "merge_policy": "source_backed_term_alias_only",
+        },
+        "business_fact_ledger": {
+            "items": [
+                {
+                    "fact_id": "fact:alias",
+                    "status": "ACCEPTED",
+                    "kind": "TERM_ALIAS",
+                    "fact_type": "TERM_ALIAS",
+                    "canonical_term": "订单",
+                    "alias": "Order",
+                    "source_spans": _span("TERM-1", "Order | 订单"),
+                },
+                *facts,
+            ]
+        },
+        "document_semantic_trees": {
+            "items": [
+                {
+                    "nodes": [
+                        {
+                            "node_id": "heading:order-status",
+                            "block_type": "HEADING",
+                            "title": "Order.status",
+                            "path_titles": ["状态字段定义", "Order.status"],
+                            "source_id": "source:rules",
+                        },
+                        {
+                            "node_id": "state:open",
+                            "parent_id": "heading:order-status",
+                            "block_type": "LIST_ITEM",
+                            "title": "- OPEN: 待发货",
+                            "path_titles": ["状态字段定义", "Order.status"],
+                            "source_id": "source:rules",
+                        },
+                        {
+                            "node_id": "state:closed",
+                            "parent_id": "heading:order-status",
+                            "block_type": "LIST_ITEM",
+                            "title": "- CLOSED: 已关闭",
+                            "path_titles": ["状态字段定义", "Order.status"],
+                            "source_id": "source:rules",
+                        },
+                    ]
+                }
+            ]
+        },
+    }
+
+
+def test_under_specified_state_rules_do_not_merge_without_positive_equivalence() -> None:
+    first = _fact("BR-STATE-1", "STATE_TRANSITION", "只有OPEN状态的订单可以发货")
+    second = _fact("BR-STATE-2", "STATE_TRANSITION", "只有CLOSED状态的订单可以归档")
+
+    rows, merge_count = _merge_same_signature([first, second])
+
+    assert len(rows) == 2
+    assert merge_count == 0
+
+
+def test_source_declared_state_guard_becomes_typed_condition_and_effect() -> None:
+    raw = _fact(
+        "BR-STATE-1",
+        "STATE_TRANSITION",
+        "只有OPEN状态的订单可以发货",
+        interface_id="api:POST:/orders/{id}/ship",
+    )
+
+    result = normalize_explicit_business_fact_semantics(_asset([raw]))
+    row = next(item for item in result["business_fact_ledger"]["items"] if item["fact_id"] == raw["fact_id"])
+
+    assert row["condition_slots"] == [
+        {
+            "field_candidate": "Order.status",
+            "operator_candidate": "EQUALS",
+            "value_candidate": {"raw": "OPEN", "value_type": "ENUM", "normalized_value": "OPEN"},
+            "source_kind": "SOURCE_DECLARED_STATE_GUARD",
+            "status": "CONFIRMED_SOURCE_TEXT",
+        }
+    ]
+    assert row["state_effects"][0]["from_state"] == "OPEN"
+    assert row["state_effects"][0]["to_state"] == "SHIPPED"
+
+
+def test_source_state_alias_supports_negative_guard_without_guessing() -> None:
+    raw = _fact("BR-STATE-2", "STATE_TRANSITION", "已关闭的订单不能评论")
+
+    result = normalize_explicit_business_fact_semantics(_asset([raw]))
+    row = next(item for item in result["business_fact_ledger"]["items"] if item["fact_id"] == raw["fact_id"])
+
+    assert row["condition_slots"][0]["field_candidate"] == "Order.status"
+    assert row["condition_slots"][0]["operator_candidate"] == "NOT_EQUALS"
+    assert row["condition_slots"][0]["value_candidate"]["normalized_value"] == "CLOSED"
+
+
+def test_behavior_ir_consumes_fact_owned_typed_condition_slots() -> None:
+    fact = _fact("BR-STATE-1", "STATE_TRANSITION", "只有OPEN状态的订单可以发货")
+    fact.update(
+        {
+            "action": {"canonical": "发货", "raw": "发货"},
+            "condition_slots": [
+                {
+                    "field_candidate": "Order.status",
+                    "operator_candidate": "EQUALS",
+                    "value_candidate": {"raw": "OPEN", "value_type": "ENUM", "normalized_value": "OPEN"},
+                    "source_kind": "SOURCE_DECLARED_STATE_GUARD",
+                    "status": "CONFIRMED_SOURCE_TEXT",
+                }
+            ],
+            "conditions": ["OPEN"],
+        }
+    )
+
+    behavior = _behavior_from_fact(fact)
+
+    assert behavior is not None
+    assert behavior["preconditions"][0]["field_candidate"] == "Order.status"
+    assert behavior["preconditions"][0]["operator_candidate"] == "EQUALS"
+
+
+def test_state_machine_object_resolves_only_through_source_alias() -> None:
+    lifecycles, unknowns = build_lifecycles(_asset([]), [], ["订单"])
+
+    assert any(row["object_ref"] == "订单" and "OPEN" in row["states"] for row in lifecycles)
+    assert not any(row.get("reason_code") == "STATE_MACHINE_OBJECT_UNRESOLVED" for row in unknowns)
+
+
+def test_state_catalog_prefers_source_business_alias_over_exact_technical_label() -> None:
+    catalog = source_declared_state_catalog(_asset([]), ["订单", "Order"])
+
+    assert set(catalog) == {"订单"}
+    assert catalog["订单"][0]["field"] == "Order.status"
+
+
+def test_explicit_authorization_row_declares_allow_but_generic_may_does_not() -> None:
+    explicit = _fact("BR-AUTH-1", "AUTHORIZATION", "只有客户可以创建订单")
+    generic = _fact("BR-RULE-1", "BUSINESS_RULE", "客户可以查看订单")
+    result = normalize_explicit_business_fact_semantics(_asset([explicit, generic]))
+    by_id = {row["fact_id"]: row for row in result["business_fact_ledger"]["items"]}
+
+    assert by_id[explicit["fact_id"]]["authorization_semantics"]["decision"] == "ALLOW"
+    assert "authorization_semantics" not in by_id[generic["fact_id"]]
