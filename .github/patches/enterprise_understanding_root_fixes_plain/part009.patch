+def _canonical_source_bytes(path_ref: str, data: bytes) -> tuple[bytes, bool]:
+    """Normalize only transport-level line endings for declared text sources.
+
+    Git checkouts and ZIP exports may materialize the same repository blob with
+    LF or CRLF line endings. Treating that transport difference as enterprise
+    source drift blocks the whole comprehension pipeline on Windows. The
+    canonical identity therefore normalizes CRLF/lone-CR to LF for known text
+    artifacts, while binary and unknown file types retain exact-byte identity.
+
+    No whitespace, Unicode, BOM, ordering, or semantic normalization occurs.
+    Any content change beyond line-ending representation still fails closed.
+    """
+
+    if Path(path_ref).suffix.lower() not in _CANONICAL_TEXT_SUFFIXES:
+        return data, False
+    try:
+        data.decode("utf-8")
+    except UnicodeDecodeError:
+        return data, False
+    canonical = data.replace(b"\r\n", b"\n").replace(b"\r", b"\n")
+    return canonical, canonical != data
+
+
+def _source_blob_identity(path_ref: str, data: bytes) -> dict[str, Any]:
+    """Return exact and portable source identities from one authority."""
+
+    canonical, normalized = _canonical_source_bytes(path_ref, data)
+    raw_sha = _git_blob_sha(data)
+    canonical_sha = _git_blob_sha(canonical)
+    return {
+        "raw_blob_sha": raw_sha,
+        "canonical_blob_sha": canonical_sha,
+        "raw_size": len(data),
+        "canonical_size": len(canonical),
+        "line_ending_normalized": normalized,
+        "identity_mode": (
+            "CANONICAL_UTF8_TEXT_GIT_BLOB"
+            if canonical_sha != raw_sha
+            else "EXACT_GIT_BLOB"
+        ),
+    }
