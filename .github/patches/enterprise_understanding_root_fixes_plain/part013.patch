++    statement = f"实体={alias};说明={canonical}"
++    return {
++        "fact_id": fact_id,
++        "kind": "TERM_ALIAS",
++        "status": "ACCEPTED",
++        "canonical_term": canonical,
++        "alias": alias,
++        "raw_statement": statement,
++        "source_spans": [
++            {
++                "source_id": "business-rules",
++                "locator": f"BUSINESS_RULES.md#alias={fact_id}",
++                "quote": statement,
++                "quote_hash": f"hash-{fact_id}",
++            }
++        ],
++        "ambiguities": [],
++    }
