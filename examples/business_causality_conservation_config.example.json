{
  "business_causality_execution_mode": "safe_live",
  "business_causality_conservation": {
    "max_records": 2000,
    "max_pages": 12,
    "max_response_bytes": 3000000,
    "contracts": [
      {
        "type": "side_effect",
        "source_path": "/orders",
        "dependent_path": "/payments",
        "source_identity_fields": ["order_id"],
        "dependent_foreign_key": "order_id",
        "state_field": "status",
        "required_states": ["paid", "completed"],
        "min_count": 1,
        "max_count": 1,
        "source_amount_field": "payable_amount",
        "dependent_amount_field": "amount",
        "amount_relation": "sum_equal",
        "tolerance": 0.01,
        "source_query": {"created_after": "2026-01-01"},
        "dependent_query": {"created_after": "2026-01-01"}
      },
      {
        "type": "side_effect",
        "source_path": "/refunds",
        "dependent_path": "/ledger-entries",
        "source_identity_fields": ["refund_id"],
        "dependent_foreign_key": "refund_id",
        "state_field": "status",
        "required_states": ["refunded", "completed"],
        "min_count": 1,
        "max_count": 1,
        "source_amount_field": "refund_amount",
        "dependent_amount_field": "amount",
        "amount_relation": "sum_equal",
        "tolerance": 0.01
      },
      {
        "type": "record_conservation",
        "source_path": "/orders",
        "source_identity_fields": ["order_id"],
        "expected_field": "total_amount",
        "positive_fields": ["subtotal_amount", "tax_amount", "shipping_amount"],
        "negative_fields": ["discount_amount", "coupon_amount"],
        "tolerance": 0.01
      }
    ]
  }
}
