{
  "openapi": "3.0.3",
  "info": {
    "title": "Enterprise Shop API",
    "version": "1.0.0"
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "List visible products",
        "security": [],
        "responses": {
          "200": {
            "description": "Product list"
          }
        }
      }
    },
    "/products/{product_id}": {
      "get": {
        "operationId": "getProduct",
        "summary": "Get product detail",
        "security": [],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product detail"
          },
          "404": {
            "description": "Product not found"
          }
        }
      }
    },
    "/api/cart/items": {
      "post": {
        "operationId": "addCartItem",
        "summary": "Add product to cart and validate stock",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["product_id", "quantity"],
                "properties": {
                  "product_id": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item added"
          },
          "400": {
            "description": "Invalid quantity"
          },
          "409": {
            "description": "Insufficient inventory"
          }
        }
      }
    },
    "/api/checkout/quote": {
      "post": {
        "operationId": "quoteCheckout",
        "summary": "Quote checkout amount with coupon and VIP discount",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "coupon_code": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkout quote"
          },
          "400": {
            "description": "Invalid coupon or empty cart"
          }
        }
      }
    },
    "/api/orders": {
      "post": {
        "operationId": "createOrder",
        "summary": "Create paid order and reduce inventory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "payment_method": {
                    "type": "string"
                  },
                  "coupon_code": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created"
          },
          "400": {
            "description": "Invalid order"
          },
          "409": {
            "description": "Inventory conflict"
          }
        }
      }
    },
    "/api/orders/{order_id}": {
      "get": {
        "operationId": "getOrder",
        "summary": "Get own order detail",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order detail"
          },
          "403": {
            "description": "Order ownership denied"
          },
          "404": {
            "description": "Order not found"
          }
        }
      }
    },
    "/api/admin/orders": {
      "get": {
        "operationId": "listAdminOrders",
        "summary": "Admin lists all orders",
        "x-requires-role": "admin",
        "responses": {
          "200": {
            "description": "All orders"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/api/admin/inventory/{product_id}": {
      "patch": {
        "operationId": "updateInventory",
        "summary": "Admin updates inventory",
        "x-requires-role": "admin",
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["stock"],
                "properties": {
                  "stock": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inventory updated"
          },
          "400": {
            "description": "Invalid stock"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  }
}
