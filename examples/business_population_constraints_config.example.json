{
  "business_population_constraints_execution_mode": "safe_live",
  "business_population_constraints": {
    "max_records": 2000,
    "max_pages": 12,
    "max_response_bytes": 3000000,
    "contracts": [
      {
        "type": "group_limit",
        "path": "/orders",
        "group_by": ["customer_id"],
        "metric_field": "payable_amount",
        "max_sum": 10000,
        "window_field": "created_at",
        "window": "day",
        "identity_fields": ["order_id"],
        "tolerance": 0.01
      },
      {
        "type": "interval_overlap",
        "path": "/room-reservations",
        "group_by": ["room_id"],
        "start_field": "start_time",
        "end_field": "end_time",
        "max_concurrent": 1,
        "identity_fields": ["reservation_id"]
      },
      {
        "type": "composite_unique",
        "path": "/subscriptions",
        "unique_fields": ["customer_id", "plan_id", "effective_date"],
        "identity_fields": ["subscription_id"]
      },
      {
        "type": "batch_integrity",
        "path": "/import-jobs",
        "batch_id_field": "job_id",
        "expected_count_field": "total_count",
        "processed_count_field": "processed_count",
        "success_count_field": "success_count",
        "failed_count_field": "failed_count",
        "status_field": "status",
        "terminal_statuses": ["completed", "failed"],
        "identity_fields": ["job_id"]
      },
      {
        "type": "approval_threshold",
        "path": "/expense-requests",
        "amount_field": "amount",
        "threshold": 5000,
        "approval_status_field": "approval_status",
        "approval_reference_field": "approval_id",
        "approved_values": ["approved", "passed", "已通过"],
        "identity_fields": ["expense_id"]
      }
    ]
  }
}
