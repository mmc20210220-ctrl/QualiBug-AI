{
  "consistency_isolation_execution_mode": "safe_live",
  "consistency_isolation_reasoning": {
    "max_source_pages": 12,
    "max_response_bytes": 3000000,
    "tenant_contracts": [
      {
        "path": "/orders",
        "identity_field": "order_id",
        "tenant_field": "tenant_id",
        "detail_path_template": "/orders/{order_id}",
        "verify_cross_access": true,
        "cross_access_sample_limit": 3,
        "contexts": [
          {
            "name": "tenant_a",
            "tenant_value": "tenant-a",
            "token_env": "QUALIBUG_TENANT_A_TOKEN",
            "headers": {
              "X-Tenant-ID": "tenant-a"
            }
          },
          {
            "name": "tenant_b",
            "tenant_value": "tenant-b",
            "token_env": "QUALIBUG_TENANT_B_TOKEN",
            "headers": {
              "X-Tenant-ID": "tenant-b"
            }
          }
        ]
      }
    ],
    "project_scope_contracts": [
      {
        "resource": "project report",
        "path": "/api/findings",
        "project_param": "project",
        "allowed_statuses": [200],
        "denied_statuses": [401, 403, 404],
        "contexts": [
          {
            "name": "project_alpha",
            "headers": {
              "X-Project-Scopes": "sandbox-alpha"
            },
            "token_env": "QUALIBUG_PROJECT_ALPHA_TOKEN",
            "allowed_project": "sandbox-alpha",
            "foreign_project": "sandbox-bravo"
          }
        ]
      }
    ],
    "async_contracts": [
      {
        "path": "/exports/jobs",
        "identity_field": "job_id",
        "status_field": "status",
        "success_states": ["succeeded", "completed"],
        "failure_states": ["failed", "cancelled"],
        "required_result_fields": ["download_url", "file_id"],
        "failure_evidence_fields": ["error_code", "error_message"]
      }
    ],
    "read_model_contracts": [
      {
        "source_path": "/orders",
        "target_path": "/order-search-index",
        "identity_field": "order_id",
        "compare_fields": ["status", "amount", "customer_id"],
        "source_updated_at_field": "updated_at",
        "target_updated_at_field": "updated_at",
        "staleness_tolerance_seconds": 60
      }
    ],
    "stability_contracts": [
      {
        "path": "/catalog",
        "identity_field": "product_id",
        "stable_fields": ["title", "price", "status"],
        "repeat_count": 2,
        "delay_ms": 100
      }
    ]
  }
}
