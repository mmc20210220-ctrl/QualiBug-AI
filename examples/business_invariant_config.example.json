{
  "project_name": "Enterprise Quality Demo",
  "base_url": "https://staging.example.com",
  "openapi_source": "json",
  "discovery_mode": "safe",
  "business_invariant_execution_mode": "safe_live",
  "business_invariant_mining": {
    "max_source_pages": 12,
    "max_relation_samples": 12,
    "max_response_bytes": 3000000,
    "collections": [
      {
        "path": "/orders",
        "identity_fields": ["order_id"],
        "filters": [
          {"parameter": "status", "field": "status", "value": "paid"},
          {"parameter": "tenant_id", "field": "tenant_id", "value": "tenant_demo"}
        ],
        "foreign_keys": [
          {"field": "customer_id", "target_path": "/customers/{customer_id}"},
          {"field": "assignee_id", "target_path": "/users/{assignee_id}"}
        ],
        "temporal_pairs": [
          {"start": "valid_from", "end": "valid_to"}
        ],
        "ignore_fields": ["legacy_import_note"]
      }
    ]
  }
}
