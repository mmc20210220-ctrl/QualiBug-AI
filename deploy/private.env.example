# QualiBug private pilot runtime example.
# Do not store credentials in this file. Connectors should use vault:, env: or
# secret_ref: references.

QUALIBUG_PRIVATE_ROOT=/var/lib/qualibug
QUALIBUG_BIND_HOST=127.0.0.1
QUALIBUG_PORT=8088

# Allow public binding only when a trusted reverse proxy, enterprise SSO/OIDC
# and network ACLs are already configured.
QUALIBUG_ALLOW_PUBLIC_BIND=0

# Localhost-only convenience mode for private pilots and demos. When enabled
# and the service binds to 127.0.0.1/localhost, missing trusted actor headers
# are mapped to QUALIBUG_LOCAL_ACTOR / QUALIBUG_LOCAL_ROLE. This is ignored for
# public binding; production deployments should set this to 0 and use a trusted
# reverse proxy to inject identity headers.
QUALIBUG_LOCAL_DEV_ACTOR=1
QUALIBUG_LOCAL_ACTOR=local_dev
QUALIBUG_LOCAL_ROLE=project_owner
