{
  "environment_kind": "sandbox",
  "base_url": "http://127.0.0.1:8011",
  "default_headers": {
    "Authorization": "Bearer benchmark-demo-token",
    "X-Tenant-Id": "t-a"
  },
  "allow_write_probes": true,
  "disposable_sandbox": {
    "enabled": true,
    "approval_id": "benchmark-runtime-suite-v3",
    "target_kind": "sandbox",
    "cleanup_strategy": "benchmark_reset",
    "base_url_allowlist": [
      "127.0.0.1",
      "localhost"
    ]
  },
  "auto_fixture": {
    "enabled": true
  },
  "snapshots": {
    "*": {
      "before": [
        {
          "method": "GET",
          "path": "/__state",
          "observer_kind": "benchmark_runtime_state_projection",
          "evidence_goal": "capture benchmark target business state before the negative probe",
          "source": "benchmark_runtime_validation_config"
        }
      ],
      "after": [
        {
          "method": "GET",
          "path": "/__state",
          "observer_kind": "benchmark_runtime_state_projection",
          "evidence_goal": "capture benchmark target business state after the negative probe",
          "source": "benchmark_runtime_validation_config"
        }
      ]
    }
  }
}
