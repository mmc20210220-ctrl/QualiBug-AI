# Local-only LLM configuration for the bundled MES BugLab test target.
# Copy to .env.local. Do NOT commit or upload .env.local.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=REPLACE_WITH_LOCAL_SECRET
LLM_MODEL=REPLACE_WITH_YOUR_DEEPSEEK_MODEL
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=300
LLM_THINKING_MODE=disabled
LLM_RESPONSE_FORMAT=json_object
# This package is preconfigured for its local MES BugLab target.
QUALIBUG_PROJECT=real_project_demo
QUALIBUG_LOOP_COOLDOWN_SECONDS=120
# Keep the new Phase91 graph planner in safe shadow mode for local MES validation.
GRAPH_CONTEXT_MODE=shadow
