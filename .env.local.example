# Local LLM configuration for QualiBug.
# Copy to .env.local. Do NOT commit or upload .env.local.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=REPLACE_WITH_YOUR_DEEPSEEK_MODEL
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=300
LLM_THINKING_MODE=disabled
LLM_RESPONSE_FORMAT=json_object
# This package is preconfigured for project-based discovery.
QUALIBUG_PROJECT=real_project_demo
QUALIBUG_LOOP_COOLDOWN_SECONDS=120
# Keep graph planner in shadow mode for local validation.
GRAPH_CONTEXT_MODE=shadow

# ==========================================================================
# JWT 认证密钥（部署时必须设置，否则服务拒绝启动）
# ==========================================================================
# 生成随机密钥: openssl rand -hex 32
# 本地开发可设简单值: QUALIBUG_JWT_SECRET=local-dev-only
QUALIBUG_JWT_SECRET=

# --- Service & discovery runtime ---
# Port the private pilot service binds to (default 8088).
QUALIBUG_PORT=8088
# Production mode: set to 1 (or true/yes/on) to DISABLE all external HTTP writes
# and live discovery execution. Leave unset for local/dev runs.
# QUALIBUG_PRODUCTION=0
# Base URL of the system under test (the API QualiBug probes). Required for
# any real probe execution; empty means discovery runs against the bundled
# local target only.
# QUALIBUG_TARGET_BASE_URL=http://127.0.0.1:8000/api
# SECURITY: allow the pilot service to bind a public (non-localhost) interface.
# Defaults to unset (localhost-only). Set to 1 ONLY behind a trusted reverse
# proxy / enterprise SSO gateway.
# QUALIBUG_ALLOW_PUBLIC_BIND=0

# ==========================================================================
# Browser UI smoke evidence
# ==========================================================================
# Disabled by default. Set to 1 to collect page reachability, console/network
# errors, screenshots and HAR evidence during patched private-pilot scans.
# Requires: pip install -e .[browser] && playwright install chromium
# QUALIBUG_BROWSER_UI_SMOKE=0
# Optional UI base URL. If omitted, the scanner reuses scan base_url / target URL.
# QUALIBUG_BROWSER_UI_BASE_URL=http://127.0.0.1:5174

# ==========================================================================
# Credential encryption
# ==========================================================================
# Optional: set a stable private-deployment credential encryption key.
# If omitted, the patched private pilot entrypoint provisions a local key file at:
# platform_workspace/.secrets/credential_encryption.key
# QUALIBUG_CRED_ENC_KEY=<random-local-secret>

# ==========================================================================
# 目标系统认证凭证（必须显式设置，不再有默认密码）
# ==========================================================================
# QualiBug 不会自动猜测目标系统的登录密码。必须显式配置。
# QUALIBUG_ADMIN_USER=admin
# QUALIBUG_ADMIN_PASS=<your-admin-password>
# QUALIBUG_VIEWER_USER=viewer
# QUALIBUG_VIEWER_PASS=<your-viewer-password>

# ==========================================================================
# Multi-module credentials (enterprise — one per service)
# ==========================================================================
# Pattern: QUALIBUG_SVC_<SERVICE_NAME>_<KEY>
#   SERVICE_NAME = service name from multi_service_config.json, uppercased, - _ → _
#
# Per-service auth can also be configured in:
#   platform_workspace/<project>/multi_service_config.json → services[].auth
# Values saved through the private pilot API are encrypted at rest and only
# returned to the frontend as masked credential refs.
#
# ── Example: order-service ──
# QUALIBUG_SVC_ORDER_SERVICE_BASE_URL=http://order-service.internal:8080
# QUALIBUG_SVC_ORDER_SERVICE_LOGIN_API=/auth/login
# QUALIBUG_SVC_ORDER_SERVICE_BEARER_TOKEN=<token>
#   OR (password-based auto-login):
# QUALIBUG_SVC_ORDER_SERVICE_ADMIN_USER=admin
# QUALIBUG_SVC_ORDER_SERVICE_ADMIN_PASS=<password>
# QUALIBUG_SVC_ORDER_SERVICE_VIEWER_USER=viewer
# QUALIBUG_SVC_ORDER_SERVICE_VIEWER_PASS=<password>
#   DB consistency check (optional):
# QUALIBUG_SVC_ORDER_SERVICE_DB_HOST=order-db.internal
# QUALIBUG_SVC_ORDER_SERVICE_DB_NAME=order_db
# QUALIBUG_SVC_ORDER_SERVICE_DB_USER=order_svc
# QUALIBUG_SVC_ORDER_SERVICE_DB_PASS=<password>
#
# ── Example: payment-service (different DB, different token) ──
# QUALIBUG_SVC_PAYMENT_SERVICE_BASE_URL=http://payment-service.internal:8081
# QUALIBUG_SVC_PAYMENT_SERVICE_BEARER_TOKEN=<token>
# QUALIBUG_SVC_PAYMENT_SERVICE_DB_HOST=payment-db.internal
