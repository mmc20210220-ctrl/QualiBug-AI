def _git_blob(path: str) -> str:
    return subprocess.check_output(
        ["git", "hash-object", path], text=True
    ).strip()


def _replace_once(path: str, old: str, new: str) -> None:
    target = Path(path)
    content = target.read_text(encoding="utf-8")
    count = content.count(old)
    if count != 1:
        raise RuntimeError(f"replacement_scope_invalid:{path}:count={count}")
    target.write_text(content.replace(old, new, 1), encoding="utf-8")


def main() -> None:
    if os.environ.get("QUALIBUG_SKIP_SOURCE_HASH_GUARD") != "1":
        drift = {}
        for path, expected in EXPECTED_BLOBS.items():
            actual = _git_blob(path)
            if actual != expected:
                drift[path] = {"expected": expected, "actual": actual}
        if drift:
            raise RuntimeError(f"source_blob_drift:{drift}")

    patch_path = Path("/tmp/process_event_idempotency_authority.patch")
    patch_path.write_bytes(base64.b64decode(PRODUCT_PATCH_B64))
    subprocess.run(["git", "apply", "--check", str(patch_path)], check=True)
    subprocess.run(["git", "apply", str(patch_path)], check=True)

    _replace_once(
        "tests/test_process_graph_event_transition.py",
        '{"id": "op_submit", "method": "POST", "path": "/orders", "system_ref": "orders"}',
        '{"id": "op_submit", "method": "POST", "path": "/orders", "system_ref": "orders", "request_example": {"idempotency_key": "<request_id>"}}',
    )
    _replace_once(
        "tests/test_process_graph_event_run_scope.py",
        '                "path": "/orders",\n                "system_ref": "orders",\n            },',
        '                "path": "/orders",\n                "system_ref": "orders",\n                "request_example": {\n                    "idempotency_key": "<request_id>"\n                },\n            },',
    )

    Path("tests/test_process_graph_event_idempotency_source_authority.py").write_bytes(
        base64.b64decode(NEW_TEST_B64)
    )


if __name__ == "__main__":
    main()
