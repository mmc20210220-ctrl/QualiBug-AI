+def _existing_string_path(value: str) -> Path | None:
+    """Return an existing path for a *string path candidate*.
+
+    API documents are frequently passed around as compact, one-line JSON.
+    The old ``"\n" not in value and Path(value).exists()`` heuristic treated
+    those payloads as filesystem paths first.  Once a real OpenAPI document is
+    large enough, the ``stat(2)`` call itself fails with ``ENAMETOOLONG`` and
+    aborts the whole discovery pipeline before format detection can run.
+
+    A failed path probe must therefore mean "this is content", not "the scan
+    is broken".  Keep actual ``Path`` objects strict (callers using a Path are
+    explicitly asking us to read a file), while string candidates fail soft.
+    """
+
+    if "\n" in value or "\r" in value:
+        return None
+    candidate = value.strip()
+    if not candidate:
+        return None
+    try:
+        path = Path(candidate)
+        return path if path.exists() else None
+    except (OSError, ValueError):
+        # Examples: ENAMETOOLONG for compact OpenAPI JSON, or an invalid path
+        # representation on the current platform.  In both cases the caller
+        # still has valid raw API-document content to parse.
+        return None
+
+
