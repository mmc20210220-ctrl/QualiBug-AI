+def _successful_response_schemas(operation: dict[str, Any]) -> list[dict[str, Any]]:
+    """Return source-declared 2xx response schemas without resolving refs."""
+
+    response_map = _dict(
+        operation.get("response_schema") or operation.get("responses")
+    )
+    schemas: list[dict[str, Any]] = []
+    for status, raw_response in response_map.items():
+        if not _text(status).startswith("2"):
+            continue
+        response = _dict(raw_response)
+        content = _dict(response.get("content"))
+        for media in content.values():
+            if isinstance(media, dict):
+                schema = _dict(media.get("schema"))
+                if schema:
+                    schemas.append(schema)
+        direct = _dict(response.get("schema"))
+        if direct:
+            schemas.append(direct)
+    return schemas
