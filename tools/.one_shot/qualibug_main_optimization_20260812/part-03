+def _object_response(schema_name: str) -> dict:
+    return {
+        "200": {
+            "content": {
+                "application/json": {
+                    "schema": {"$ref": f"#/components/schemas/{schema_name}"}
+                }
+            }
+        }
+    }
+
+
+def _array_response(schema_name: str) -> dict:
+    return {
+        "200": {
+            "content": {
+                "application/json": {
+                    "schema": {
+                        "type": "array",
+                        "items": {"$ref": f"#/components/schemas/{schema_name}"},
+                    }
+                }
+            }
+        }
+    }
