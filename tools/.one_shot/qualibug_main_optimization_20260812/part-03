+    assert declared_effect_observers(
+        write,
+        behavior_ir={"operations": [write, detail, health], "relations": []},
+        max_candidates=1,
+    ) == [{"operation_ref": "detail", "method": "GET", "path": "/api/resources/{id}"}]
