def _condition_leaf(slot: dict[str, Any]) -> dict[str, Any]:
    """Project one source condition slot into the canonical recursive expression."""
    raw = text(slot.get("raw_value"))
    if re.search(r"(?:之前|之后|以前|以后|前|后|时|期间|以内|之内)$", raw):
        return {
            "schema": CONDITION_EXPRESSION_SCHEMA,
            "node_type": "TEMPORAL",
            "slot_ref": slot.get("slot_id"),
            "raw_value": raw,
            "relation": next(
                (
                    value
                    for value in ("之前", "之后", "以前", "以后", "期间", "以内", "之内", "前", "后", "时")
                    if raw.endswith(value)
                ),
                "",
            ),
            "status": "CONFIRMED" if raw else "UNRESOLVED",
            "source_backed": True,
        }
    field = text(slot.get("field_candidate"))
    operator = text(slot.get("operator_candidate"))
    value = as_dict(slot.get("value_candidate"))
    complete = bool(
        field
        and operator
        and operator != "UNPARSED_EXPLICIT_CONDITION"
        and (value.get("normalized_value") is not None or text(value.get("raw")))
    )
    return {
        "schema": CONDITION_EXPRESSION_SCHEMA,
        "node_type": "PREDICATE",
        "predicate_id": stable_id(
            "condition_predicate", slot.get("slot_id"), field, operator, value
        ),
        "slot_ref": slot.get("slot_id"),
        "raw_value": raw,
        "subject_ref": text(slot.get("subject_candidate")),
        "field_candidate": field,
        "operator_candidate": operator,
        "value_candidate": value,
        "status": "CONFIRMED" if complete else "UNRESOLVED",
        "source_backed": True,
    }


def build_condition_expression(
    conditions: Iterable[dict[str, Any]],
    *,
    combinator: str = "",
    frame: dict[str, Any] | None = None,
) -> dict[str, Any]:
    """Build the only formal condition authority; legacy fields are projections of it."""
    slots = [dict(row) for row in conditions if isinstance(row, dict)]
    leaves = [_condition_leaf(slot) for slot in slots]
    explicit = text(combinator).upper()
    frame = as_dict(frame)
    if not leaves:
        return {}
    if len(leaves) == 1:
        root: dict[str, Any] = leaves[0]
    elif explicit == "AND":
        root = {
            "schema": CONDITION_EXPRESSION_SCHEMA,
            "node_type": "ALL",
            "children": leaves,
            "source_backed": True,
        }
    elif explicit == "OR":
        root = {
            "schema": CONDITION_EXPRESSION_SCHEMA,
            "node_type": "ANY",
            "children": leaves,
            "source_backed": True,
        }
    else:
        root = {
            "schema": CONDITION_EXPRESSION_SCHEMA,
            "node_type": "UNRESOLVED",
            "children": leaves,
            "reason_code": "CONDITION_COMBINATOR_UNRESOLVED",
            "source_backed": True,
        }

    exception_scopes = unique_text(
        [*as_list(frame.get("exception_scopes")), *as_list(frame.get("exceptions"))]
    )
    if exception_scopes:
        root = {
            "schema": CONDITION_EXPRESSION_SCHEMA,
            "node_type": "EXCEPT",
            "child": root,
            "exception_scopes": exception_scopes,
            "overlays": as_list(frame.get("overlays")),
            "source_backed": True,
        }

    branch = text(frame.get("branch")).upper()
    if branch in {"THEN", "ELSE", "ELSE_IF"}:
        root = {
            "schema": CONDITION_EXPRESSION_SCHEMA,
            "node_type": "BRANCH",
            "branch": branch,
            "branch_index": frame.get("branch_index", ""),
            "parent_conditions": unique_text(as_list(frame.get("parent_conditions"))),
            "paired_statement": text(frame.get("paired_statement")),
            "guard": root,
            "source_backed": True,
        }
    elif text(frame.get("kind")).upper() == "UNRESOLVED":
        root = {
            "schema": CONDITION_EXPRESSION_SCHEMA,
            "node_type": "UNRESOLVED",
            "children": [root],
            "reason_code": "CONDITION_FRAME_UNRESOLVED",
            "source_backed": True,
        }
    return root


def condition_expression_for_behavior(behavior: dict[str, Any]) -> dict[str, Any]:
    expression = as_dict(behavior.get("condition_expression"))
    if expression:
        return expression
    conditions = [
        dict(row) for row in as_list(behavior.get("preconditions")) if isinstance(row, dict)
    ]
    expression = build_condition_expression(
        conditions,
        combinator=text(behavior.get("condition_combinator")),
        frame=as_dict(behavior.get("condition_frame")),
    )
    if expression:
        behavior["condition_expression"] = expression
    return expression


def iter_condition_predicates(expression: dict[str, Any]) -> list[dict[str, Any]]:
    """Return field predicates only; temporal/branch structure stays in the expression."""
    node = as_dict(expression)
    kind = text(node.get("node_type")).upper()
    if kind == "PREDICATE":
        return [node]
    rows: list[dict[str, Any]] = []
    for child in as_list(node.get("children")):
        if isinstance(child, dict):
            rows.extend(iter_condition_predicates(child))
    for key in ("child", "guard"):
        child = as_dict(node.get(key))
        if child:
            rows.extend(iter_condition_predicates(child))
    return rows


def condition_expression_combinator(expression: dict[str, Any]) -> str:
    node = as_dict(expression)
    kind = text(node.get("node_type")).upper()
    if kind == "ALL":
        return "AND"
    if kind == "ANY":
        return "OR"
    if kind in {"PREDICATE", "TEMPORAL"}:
        return "SINGLE_CONDITION"
    if kind in {"BRANCH", "EXCEPT"}:
        return condition_expression_combinator(
            as_dict(node.get("guard") or node.get("child"))
        )
    return "UNRESOLVED" if kind else ""


def condition_expression_complete(expression: dict[str, Any]) -> bool:
    node = as_dict(expression)
    if not node:
        return True
    kind = text(node.get("node_type")).upper()
    if kind == "PREDICATE":
        return text(node.get("status")) == "CONFIRMED"
    if kind == "TEMPORAL":
        return bool(text(node.get("raw_value")) and text(node.get("relation")))
    if kind in {"ALL", "ANY"}:
        children = [row for row in as_list(node.get("children")) if isinstance(row, dict)]
        return len(children) >= 2 and all(condition_expression_complete(row) for row in children)
    if kind == "EXCEPT":
        return bool(as_list(node.get("exception_scopes"))) and condition_expression_complete(
            as_dict(node.get("child"))
        )
    if kind == "BRANCH":
        return (
            text(node.get("branch")) in {"THEN", "ELSE", "ELSE_IF"}
            and condition_expression_complete(as_dict(node.get("guard")))
        )
    return False


def _canonical_condition_node(expression: dict[str, Any]) -> dict[str, Any]:
    node = as_dict(expression)
    kind = text(node.get("node_type")).upper()
    if kind == "PREDICATE":
        return {
            "node_type": kind,
            "subject_ref": text(node.get("subject_ref")),
            "field_candidate": text(node.get("field_candidate")),
            "operator_candidate": text(node.get("operator_candidate")),
            "value_candidate": as_dict(node.get("value_candidate")),
            "status": text(node.get("status")),
        }
    if kind == "TEMPORAL":
        return {
            "node_type": kind,
            "raw_value": text(node.get("raw_value")),
            "relation": text(node.get("relation")),
        }
    if kind in {"ALL", "ANY", "UNRESOLVED"}:
        children = [
            _canonical_condition_node(row)
            for row in as_list(node.get("children"))
            if isinstance(row, dict)
        ]
        if kind in {"ALL", "ANY"}:
            children = sorted(
                children,
                key=lambda row: json.dumps(row, ensure_ascii=False, sort_keys=True, default=str),
            )
        return {
            "node_type": kind,
            "reason_code": text(node.get("reason_code")),
            "children": children,
        }
    if kind == "EXCEPT":
        return {
            "node_type": kind,
            "exception_scopes": sorted(unique_text(as_list(node.get("exception_scopes")))),
            "child": _canonical_condition_node(as_dict(node.get("child"))),
        }
    if kind == "BRANCH":
        return {
            "node_type": kind,
            "branch": text(node.get("branch")),
            "branch_index": node.get("branch_index", ""),
            "parent_conditions": unique_text(as_list(node.get("parent_conditions"))),
            "guard": _canonical_condition_node(as_dict(node.get("guard"))),
        }
    return {"node_type": kind}


def condition_expression_signature(expression: dict[str, Any]) -> str:
    return json.dumps(
        _canonical_condition_node(expression),
        ensure_ascii=False,
        sort_keys=True,
        default=str,
    )


