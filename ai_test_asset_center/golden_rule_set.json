    {
      "rule_id": "conservation.inventory.reserve_sum",
      "rule_type": "conservation",
      "business_description": "库存预占时 available_qty + locked_qty 总和不变",
      "scope": {
        "primary_entity_id": "inventory",
        "related_entity_ids": ["orders"],
        "correlation_keys": ["sku"]
      },
      "preconditions": [
        {"entity_id": "inventory", "field_id": "available_qty", "operator": "GTE", "expected_value": 1}
      ],
      "operation": {
        "operation_id": "inventory.reserve",
        "actor_role": "buyer",
        "parameter_bindings": [{"param": "sku", "source": "fixture"}, {"param": "qty", "source": "literal", "value": 1}]
      },
      "expected_field_changes": [
        {"entity_id": "inventory", "field_id": "available_qty", "delta_expression": "-qty"},
        {"entity_id": "inventory", "field_id": "locked_qty", "delta_expression": "+qty"}
      ],
      "unchanged_fields": [
        {"entity_id": "inventory", "field_id": "available_qty+locked_qty"}
      ],
      "observation_plan": {
        "before_observers": ["GET /api/inventory/{sku}"],
        "after_observers": ["GET /api/inventory/{sku}"]
      },
      "oracle": {
        "expression_type": "conservation",
        "expression": {
          "operator": "unchanged_sum",
          "terms": ["available_qty", "locked_qty"]
        },
        "tolerance": 0
      },
      "source_evidence": [
        {"source_id": "BUSINESS_RULES.md", "location": "库存规则", "original_text": "用户下单时，应扣减 available_qty 并增加 locked_qty", "confidence": 0.95}
      ]
    },
