{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "prebuild": "npm run brand:check",
    "build": "vite build",
    "start": "vite preview --host",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"vite.config.ts\" \"eslint.config.mjs\" --max-warnings=0",
    "openapi:export": "cd .. && python -m ai_test_asset_center.phase104_api_contract_exporter --output-dir frontend/openapi/phase104_api_contract",
    "openapi:gen": "node scripts/openapi/generate.mjs",
    "openapi:check": "node scripts/openapi/check.mjs",
    "typecheck": "tsc --noEmit",
    "redaction:scan": "node scripts/security/redaction-scan.mjs",
    "audit:check": "node scripts/security/npm-audit-baseline.mjs",
    "brand:export": "node scripts/brand/export-assets.mjs",
    "brand:check": "node scripts/brand/export-assets.mjs --check",
    "test:login-radar": "node scripts/brand/login-radar-canvas-contract.mjs",
    "test:brand-canvas": "npm run test:login-radar",
    "test:brand-mark": "node scripts/brand/brand-mark-contract.mjs",
    "test:login-contract": "node scripts/login-page-contract.mjs",
    "test:autonomous-ux": "node scripts/autonomous-ux-contract.mjs",
    "test:frontend-finalization": "node scripts/frontend-finalization-contract.mjs",
    "test:settings-onboarding": "node scripts/settings-onboarding-contract.mjs",
    "test:run-lifecycle": "node scripts/run-lifecycle-contract.mjs",
    "test:run-customer-result": "node scripts/run-customer-result-contract.mjs",
    "test:run-preflight-decision": "node scripts/run-preflight-decision-contract.mjs",
    "test:live-scan-status": "node scripts/live-scan-status-contract.mjs",
    "test:dashboard-role-views": "node scripts/dashboard-role-views-contract.mjs",
    "test:dashboard-decision-first": "node scripts/dashboard-decision-first-contract.mjs",
    "test:release-decision-first": "node scripts/release-decision-first-contract.mjs",
    "test:customer-action-guidance": "node scripts/customer-action-guidance-contract.mjs",
    "test:finding-context-navigation": "node scripts/finding-context-navigation-contract.mjs",
    "test:finding-validation-boundary": "node scripts/finding-validation-boundary-contract.mjs",
    "test:finding-verification-timeline": "node scripts/finding-verification-timeline-contract.mjs",
    "test:finding-verification-focus": "node scripts/finding-verification-focus-contract.mjs",
    "test:finding-decision-snapshot": "node scripts/finding-decision-snapshot-contract.mjs",
    "test:evidence-distribution": "node scripts/evidence-distribution-contract.mjs",
    "test:evidence-share": "node scripts/evidence-share-contract.mjs",
    "test:materials-coverage": "node scripts/materials-coverage-contract.mjs",
    "test:materials-acceptance": "node scripts/materials-acceptance-contract.mjs",
    "test:materials-remote-lifecycle": "node scripts/materials-remote-lifecycle-contract.mjs",
    "ci:gate": "node scripts/ci-gate.mjs",
    "dev:vite": "vite --host"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5",
    "typescript-eslint": "^8.35.1",
    "vite": "^8.1.1"
  }
}