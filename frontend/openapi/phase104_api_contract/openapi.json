{
  "components": {
    "parameters": {
      "ProjectId": {
        "in": "path",
        "name": "project_id",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "RiskId": {
        "in": "path",
        "name": "risk_id",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "RunId": {
        "in": "path",
        "name": "run_id",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "ApiEnvelope": {
        "properties": {
          "data": {
            "description": "业务数据对象。具体结构以对应页面对象为准。"
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ApiError"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          },
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
        "type": "object"
      },
      "ApiError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ApiMeta": {
        "properties": {
          "generated_at": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ApplyTemplateRequest": {
        "properties": {
          "approved_by": {
            "type": "string"
          },
          "role_config": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object"
          },
          "template_id": {
            "type": "string"
          }
        },
        "required": [
          "template_id"
        ],
        "type": "object"
      },
      "BusinessModelPatchRequest": {
        "properties": {
          "approved_by": {
            "type": "string"
          },
          "confirmed_business_flows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          "confirmed_risk_focus": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "confirmed_roles": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "EnvironmentConfigPatchRequest": {
        "properties": {
          "api_smoke_paths": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "auth_type": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "credential_status": {
            "additionalProperties": true,
            "description": "仅提交凭证状态或脱敏占位，不应在日志/报告中展示原值。",
            "type": "object"
          },
          "safe_execution_mode": {
            "type": "string"
          },
          "session_health_path": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "EnvironmentPreflightRequest": {
        "properties": {
          "checks": {
            "additionalProperties": true,
            "type": "object"
          },
          "safe_execution_mode": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProjectCreateRequest": {
        "properties": {
          "customer_name": {
            "type": "string"
          },
          "industry": {
            "enum": [
              "manufacturing",
              "ecommerce",
              "saas",
              "finance",
              "healthcare",
              "government",
              "education",
              "logistics"
            ],
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "planned_launch_date": {
            "type": "string"
          },
          "project_name": {
            "type": "string"
          },
          "system_name": {
            "type": "string"
          },
          "system_type": {
            "type": "string"
          },
          "test_goal": {
            "type": "string"
          }
        },
        "required": [
          "project_name",
          "customer_name",
          "system_name",
          "industry"
        ],
        "type": "object"
      },
      "TestPlanGenerateRequest": {
        "properties": {
          "plan_name": {
            "type": "string"
          },
          "safe_execution_mode": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "TestRunStartRequest": {
        "properties": {
          "findings": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          "run_id": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
