    "tracking_variables": [
      "_no_progress_streak",
      "_prev_plan_fingerprint",
      "_same_plan_streak",
      "_prev_dominant_error",
      "_same_error_streak",
      "_early_stop_reason"
    ],
    "observability": "early_stop_reason field attached to plan_row for audit trail"
  },
  "verification": {
    "no_waste_rounds": true,
    "deterministic_stop": true,
    "stop_reason_logged": true,
