{
  "schema_version": "qualibug.project-f-round-stop-policy-audit.v1",
  "created_at": "2026-07-23T00:00:00+08:00",
  "round_policy": {
    "round_type": "Planning Round (follow-on rounds in discovery_runtime_execution_support.py)",
    "max_rounds": 48,
    "source_constant": "ai_test_asset_center/pipeline_slices.py:_ABS_MAX_ROUND_LIMIT",
