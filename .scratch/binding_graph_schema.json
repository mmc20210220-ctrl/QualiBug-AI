{
  "schema_version": "qualibug.binding-graph-schema.v1",
  "title": "Unified Binding Graph Schema",
  "description": "Defines the structure of binding edges connecting Behavior IR nodes to runtime objects",
  "binding_edge_schema": {
    "binding_id": "string (content-addressed: bind_{sha256[:16]})",
    "binding_type": "enum: entity|operation|field|relation|state|actor|scope|fixture|observer|oracle_input",
    "source_node_id": "string (Behavior IR node ID)",
    "target_key": "string (runtime target identifier)",
    "status": "enum: CANDIDATE|HIGH_CONFIDENCE|RUNTIME_CONFIRMED|EXECUTABLE|CONFLICTED|REJECTED|STALE",
    "confidence": "float 0.0-1.0",
    "evidence": "list[evidence_entry]",
    "source_module": "string (module that created this binding)",
    "metadata": "dict (type-specific metadata)",
    "version": "int (monotonically increasing)",
    "created_at": "float (unix timestamp)",
    "updated_at": "float (unix timestamp)",
    "transition_history": "list[{from_status, to_status, reason, timestamp}]",
    "conflict_info": "dict|null",
    "probe_result": "dict|null"
  },
  "evidence_entry_schema": {
    "dimension": "enum: semantic_name|entity_context|data_type|operation_context|schema_relation|source_consistency|runtime_behavior|correlation_consistency",
    "score": "float 0.0-1.0",
    "detail": "string",
    "source_ref": "string",
    "metadata": "dict",
    "timestamp": "float",
    "evidence_id": "string"
  },
  "state_machine": {
    "states": ["CANDIDATE", "HIGH_CONFIDENCE", "RUNTIME_CONFIRMED", "EXECUTABLE", "CONFLICTED", "REJECTED", "STALE"],
    "transitions": {
      "CANDIDATE": ["HIGH_CONFIDENCE", "CONFLICTED", "REJECTED", "STALE"],
      "HIGH_CONFIDENCE": ["RUNTIME_CONFIRMED", "EXECUTABLE", "CONFLICTED", "REJECTED", "STALE"],
      "RUNTIME_CONFIRMED": ["EXECUTABLE", "CONFLICTED", "STALE"],
      "EXECUTABLE": ["STALE", "CONFLICTED"],
      "CONFLICTED": ["HIGH_CONFIDENCE", "REJECTED", "CANDIDATE"],
      "REJECTED": ["CANDIDATE"],
      "STALE": ["CANDIDATE"]
    },
    "terminal_states": ["EXECUTABLE", "REJECTED"],
    "gate_thresholds": {
      "high_confidence": ">=0.90",
      "needs_probe": "0.70-0.90",
      "unusable": "<0.70"
    }
  },
  "binding_type_metadata": {
    "entity": {
      "required_fields": ["create_operation_ref", "read_operation_ref", "runtime_id_path"],
      "optional_fields": ["primary_observer_ref", "collection_path", "alternate_paths"]
    },
    "operation": {
      "required_fields": ["endpoint_path", "method"],
      "optional_fields": ["actor_requirements", "request_bindings", "response_bindings", "content_type"]
    },
    "field": {
      "required_fields": ["field_name", "field_type_classification"],
      "optional_fields": ["entity_ref", "operation_ref", "request_path", "response_path", "constraints"],
      "field_type_classifications": ["IDENTITY", "FOREIGN_KEY", "OWNER_ID", "STATE", "QUANTITY_BALANCE", "TEMPORAL", "ENUM_STATUS", "MONEY", "UNIQUE_CODE", "BOOLEAN_FLAG", "TEXT_NAME", "REFERENCE_CODE", "COMPOSITE", "NESTED_OBJECT", "ARRAY_COLLECTION"]
    },
    "relation": {
      "required_fields": ["source_entity_ref", "target_entity_ref", "correlation_key"],
      "optional_fields": ["materialization_operation_ref", "cardinality", "cascade_behavior"]
    },
    "state": {
      "required_fields": ["state_field_name", "entity_ref"],
      "optional_fields": ["raw_values", "transition_operations", "observer_ref", "initial_value", "terminal_values"]
    },
    "actor": {
      "required_fields": ["actor_ref", "credential_secret_ref"],
      "optional_fields": ["role", "account_ref", "tenant_scope", "organization_scope"]
    },
    "scope": {
      "required_fields": ["scope_type", "scope_field"],
      "optional_fields": ["scope_value_source", "isolation_level", "filter_parameter"]
    },
    "fixture": {
      "required_fields": ["create_operation_ref", "body_template"],
      "optional_fields": ["cleanup_operations", "state_advancement_chain", "dependency_fixtures", "actor_refs"]
    },
    "observer": {
      "required_fields": ["read_operation_ref", "observed_fields"],
      "optional_fields": ["supported_entities", "scope_keys", "filter_parameters", "cardinality"]
    },
    "oracle_input": {
      "required_fields": ["oracle_ref", "input_field_bindings"],
      "optional_fields": ["source_observer_ref", "comparator", "expected_value_source"]
    }
  },
  "integration_points": {
    "behavior_ir": "Binding edges reference IR node IDs via source_node_id",
    "binding_plan": "build_binding_plan() consumes EXECUTABLE bindings from ledger",
    "experiment_compiler": "compile_experiment_for_obligation() checks binding gate before proceeding",
    "fixture_materializer": "Consumes fixture and entity bindings for setup",
    "observer_binder": "Consumes observer bindings for read operation selection",
    "oracle_activation": "Consumes oracle_input bindings for evidence requirements"
  }
}
